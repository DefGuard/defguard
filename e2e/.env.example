IMAGE_TAG=latest

BASE_URL=http://localhost:8000
CORE_BASE_URL=http://localhost:8000/api/v1
ENROLLMENT_URL=http://localhost:8080

# Optional: host port for the test database, if 5432 is already in use
# E2E_DB_PORT=15432

# Optional: override individual image tags; each defaults to IMAGE_TAG.
# Example: IMAGE_TAG=dev with CORE_IMAGE_TAG=local uses a locally built Core image.
# CORE_IMAGE_TAG=local
# EDGE_IMAGE_TAG=dev
# GATEWAY_IMAGE_TAG=dev

# Optional: Enterprise key seeds the snapshot used by Enterprise E2E tests
# DEFGUARD_LICENSE_KEY=your-enterprise-license-key-here
# Optional: enables Business-tier MFA coverage
# DEFGUARD_BUSINESS_LICENSE_KEY=your-business-license-key-here
