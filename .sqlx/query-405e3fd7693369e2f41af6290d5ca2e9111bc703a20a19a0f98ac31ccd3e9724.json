{
  "db_name": "PostgreSQL",
  "query": "SELECT s.device_id, date_trunc($1, collected_at) \"collected_at!: PrimitiveDateTime\", CAST(sum(download_diff) AS bigint) \"download!\", CAST(sum(upload_diff) AS bigint) \"upload!\" FROM vpn_session_stats INNER JOIN vpn_client_session s ON session_id = s.id WHERE s.device_id = ANY($2) AND collected_at >= $3 AND s.location_id = $4  GROUP BY device_id, collected_at ORDER BY device_id, collected_at",
