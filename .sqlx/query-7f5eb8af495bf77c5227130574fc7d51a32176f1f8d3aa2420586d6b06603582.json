{
  "db_name": "PostgreSQL",
  "query": "UPDATE device_identity_challenge AS challenge SET consumed_at = (clock_timestamp() AT TIME ZONE 'UTC') WHERE id = $1 AND device_id = $2 AND purpose = $3 AND location_id IS NOT DISTINCT FROM $4 AND mfa_session_id IS NOT DISTINCT FROM $5 AND consumed_at IS NULL AND expires_at > (clock_timestamp() AT TIME ZONE 'UTC') AND (mfa_session_id IS NULL OR EXISTS ( SELECT 1 FROM vpn_client_mfa_session AS session WHERE session.id = challenge.mfa_session_id AND session.token_hash = challenge.mfa_session_token_hash AND session.expires_at > (clock_timestamp() AT TIME ZONE 'UTC') AND challenge.expires_at <= session.expires_at )) RETURNING challenge.id, challenge.purpose AS \"purpose: DeviceIdentityChallengePurpose\", challenge.device_id, challenge.location_id, challenge.mfa_session_id, challenge.mfa_session_token_hash, challenge.data, challenge.created_at, challenge.expires_at, challenge.consumed_at",
