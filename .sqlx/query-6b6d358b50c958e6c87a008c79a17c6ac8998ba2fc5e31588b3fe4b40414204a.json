  "query": "SELECT d.wireguard_pubkey pubkey, d.preshared_key \"preshared_key: SecretStringWrapper\", ARRAY( SELECT host(ip) FROM unnest(wnd.wireguard_ips) AS ip ) \"allowed_ips!: Vec<String>\" FROM wireguard_network_device wnd JOIN device d ON wnd.device_id = d.id JOIN \"user\" u ON d.user_id = u.id WHERE wireguard_network_id = $1 AND d.configured AND u.is_active ORDER BY d.id ASC",
