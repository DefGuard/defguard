  "query": "INSERT INTO device_verification (device_id, started_by, secret, created_at, expires_at) VALUES ($1, $2, $3, $4, $5) ON CONFLICT (device_id) DO UPDATE SET started_by = EXCLUDED.started_by, secret = EXCLUDED.secret, created_at = EXCLUDED.created_at, expires_at = EXCLUDED.expires_at WHERE device_verification.expires_at <= (now() AT TIME ZONE 'UTC') RETURNING id, device_id, started_by, secret, created_at, expires_at",
